doctype html
html(lang="en")
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet" href="/css/style.css")
    body
        main
            .table-wrapper
                a.navigation-link(href="/update-cobj") Add to this table
                h1 Books

                if data.length
                    table
                        thead
                            tr
                                th Name
                                th Author
                                th Genre
                        tbody
                            each book in data
                                tr
                                    td= book.properties.name
                                    td= book.properties.author
                                    td= book.properties.genre
                else
                    p No books found.